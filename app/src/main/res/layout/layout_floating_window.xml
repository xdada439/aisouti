<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lay_out"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 搜题按钮 -->
        <TextView
            android:id="@+id/btn_screenshot"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_floating_glass_box"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="答"
            android:textColor="#A61A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 信息区 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_floating_glass_box"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true">

            <!-- 来源标签 + 复制按钮 -->
            <LinearLayout
                android:id="@+id/source_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#881A1A1A"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btn_copy"
                    android:layout_width="36dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="复制"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- 状态文本 -->
            <TextView
                android:id="@+id/tv_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="就绪"
                android:textColor="#661A1A1A"
                android:textSize="9sp" />

            <!-- 可滚动答案/调试区 -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_answer"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:maxHeight="260dp"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tv_data_ans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#991A1A1A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textIsSelectable="true" />
            </androidx.core.widget.NestedScrollView>

            <!-- 非滚动答案区（简短答案用） -->
            <TextView
                android:id="@+id/tv_data_ans_inline"
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="4"
                android:textColor="#991A1A1A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
